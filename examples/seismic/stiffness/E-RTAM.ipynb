    "def lapla(model, image):\n",
    "    lapla = VectorFunction(name='lapla', grid=model.grid, space_order=8)\n",
    "    stencil = Eq(lapla, -image.laplace)\n",
    "    op = Operator([stencil])\n",
    "    op.apply()\n",
    "    return lapla"
   ]
